    {"type":"text","id":"ops-text","x":78,"y":700,"width":390,"height":140,"text":"CLI stages remain independently runnable\nextract | generate | validate | transform | publish\nrun chains the complete pipeline\n\nDry-run validates the local envelope offline\nDecoded definition parts remain reviewable\nUnit/golden tests detect schema drift","fontSize":17,"fontFamily":2,"strokeColor":"#000000","backgroundColor":"transparent","textAlign":"left","verticalAlign":"top","baseline":17,"seed":402,"groupIds":[],"frameId":null,"angle":0,"opacity":100,"version":1,"versionNonce":402,"isDeleted":false,"updated":1,"link":null,"locked":false,"containerId":null,"originalText":"CLI stages remain independently runnable\nextract | generate | validate | transform | publish\nrun chains the complete pipeline\n\nDry-run validates the local envelope offline\nDecoded definition parts remain reviewable\nUnit/golden tests detect schema drift","lineHeight":1.25},
